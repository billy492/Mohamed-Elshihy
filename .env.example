# Copy to .env.local for development (or .dev.vars for `npm run preview`).
# On Cloudflare, set these as secrets under Workers & Pages → shihy-coaching →
# Settings → Variables and Secrets. NEXT_PUBLIC_SITE_URL is a BUILD variable.

# The review desk (/admin). Both are required for the desk to open.
ADMIN_PASSWORD=
# 32+ random characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Public URL, used in share images, the sitemap and links in alert emails.
NEXT_PUBLIC_SITE_URL=https://example.com

# Production storage for applications and waitlists: a free Upstash Redis
# database (console.upstash.com). Either pair of names works.
# Leave empty in development: applications go to .data/store.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: an email to Shihy for every new application, via Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Once a sending domain is verified in Resend, e.g. "Shihy Coaching <desk@yourdomain.com>"
NOTIFY_FROM=

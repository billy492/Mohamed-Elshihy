# Copy to .env.local for development. On Vercel, set these under
# Project → Settings → Environment Variables.

# The review desk (/admin). Both are required for the desk to open.
ADMIN_PASSWORD=
# 32+ random characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Public URL, used in share images, the sitemap and links in alert emails.
NEXT_PUBLIC_SITE_URL=https://example.com

# Production storage for applications and waitlists: add the Upstash Redis
# integration in the Vercel Marketplace and these two are injected for you.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.)
# Leave empty in development: applications go to .data/store.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: an email to Shihy for every new application, via Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Once a sending domain is verified in Resend, e.g. "Shihy Coaching <desk@yourdomain.com>"
NOTIFY_FROM=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud-safe build dir (see next.config.ts distDir)
.next.nosync/

# local application store (dev only — production uses Upstash Redis)
/.data/

# any local build dir (iCloud skips *.nosync)
*.nosync/
!.env.example

# client originals (processed copies live in public/assets)
/client-assets/

# cloudflare (OpenNext build output, local wrangler state)
/.open-next/
/.wrangler/
.dev.vars*
